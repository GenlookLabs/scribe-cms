{
  "name": "scribe-cms",
  "version": "0.0.27",
  "description": "Typed, file-based CMS for multilingual MDX sites",
  "homepage": "https://scribe.genlook.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenlookLabs/scribe-cms.git"
  },
  "bugs": {
    "url": "https://github.com/GenlookLabs/scribe-cms/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cms",
    "mdx",
    "i18n",
    "zod",
    "content",
    "translation"
  ],
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./studio": {
      "types": "./dist/studio/server.d.ts",
      "import": "./dist/studio/server.js"
    },
    "./rescue": {
      "types": "./dist/src/rescue.d.ts",
      "import": "./dist/rescue.js",
      "require": "./dist/rescue.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "scribe": "./bin/scribe.js"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --import tsx --test \"src/**/*.test.ts\" \"studio/**/*.test.ts\"",
    "prepublishOnly": "pnpm build",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "@inquirer/core": "^12.0.5",
    "@inquirer/prompts": "^8.7.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "jiti": "^2.6.1",
    "js-yaml": "^5.5.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}